---
import Section from './Section.astro';
import Card from './Card.astro';
import { publications } from '../data/publications';
---
<Section title="Publications">
  {publications.map((p) => (
    <Card>
      <h3 class="text-lg font-semibold leading-snug text-slate-900 dark:text-slate-100">{p.title}</h3>
      <p class="text-sky-700 dark:text-sky-400 text-sm mt-1">{p.venue} · {p.date}</p>
      <p class="mt-3 text-slate-700 dark:text-slate-300 leading-relaxed">{p.summary}</p>
    </Card>
  ))}
</Section>
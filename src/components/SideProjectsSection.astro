---
import Section from './Section.astro';
import Card from './Card.astro';
import Tag from './Tag.astro';
import { sideProjects } from '../data/sideProjects';
---
<Section title="Side Projects">
  <div class="space-y-4">
    {sideProjects.map((p) => (
      <Card href={p.url}>
        <div class="flex items-center justify-between gap-3">
          <h3 class="text-lg font-semibold text-slate-900 dark:text-slate-100 group-hover:text-sky-700 dark:group-hover:text-sky-400 transition-colors">
            {p.name}
          </h3>
          <span class="text-slate-400 group-hover:text-sky-600 dark:group-hover:text-sky-400 transition-colors">↗</span>
        </div>
        <p class="mt-2 text-slate-700 dark:text-slate-300 leading-relaxed text-sm">{p.description}</p>
        <div class="mt-3 flex flex-wrap gap-2">
          {p.tags.map((t) => <Tag>{t}</Tag>)}
        </div>
      </Card>
    ))}
  </div>
</Section>
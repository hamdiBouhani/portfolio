---
interface Props {
  title: string;
  id?: string;
  class?: string;
}
const { title, id, class: className = '' } = Astro.props;
---
<section id={id} class={className}>
  <h2 class="text-2xl font-bold mb-6 flex items-center gap-3">
    <span class="w-1 h-6 rounded-full bg-gradient-to-b from-sky-500 to-indigo-500"></span>
    {title}
  </h2>
  <slot />
</section>
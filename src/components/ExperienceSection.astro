---
import Section from './Section.astro';
import Card from './Card.astro';
import Tag from './Tag.astro';
import { experience } from '../data/experience';
---
<Section title="Experience">
  <div class="space-y-6">
    {experience.map((job) => (
      <Card>
        <div class="flex flex-wrap items-baseline justify-between gap-2">
          <h3 class="text-lg font-semibold text-slate-900 dark:text-slate-100">{job.title}</h3>
          <span class="text-xs font-medium px-2.5 py-1 rounded-full bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400">
            {job.type}
          </span>
        </div>
        <p class="text-sky-700 dark:text-sky-400 font-medium text-sm mt-1">{job.company}</p>
        <p class="text-slate-500 dark:text-slate-400 text-sm mt-0.5">
          {job.period} · {job.location}
        </p>
        <p class="mt-3 text-slate-700 dark:text-slate-300 leading-relaxed">{job.description}</p>
        {job.bullets && (
          <ul class="mt-3 space-y-1.5 text-slate-700 dark:text-slate-300">
            {job.bullets.map((b) => (
              <li class="flex gap-2">
                <span class="text-sky-500 dark:text-sky-400 mt-1.5 shrink-0">▸</span>
                <span>{b}</span>
              </li>
            ))}
          </ul>
        )}
        {job.tech && (
          <div class="mt-4 flex flex-wrap gap-2">
            {job.tech.map((t) => <Tag>{t}</Tag>)}
          </div>
        )}
      </Card>
    ))}
  </div>
</Section>
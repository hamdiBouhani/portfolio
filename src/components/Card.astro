---
interface Props {
  href?: string;
  class?: string;
}
const { href, class: className = '' } = Astro.props;

const base =
  'rounded-xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-sm';

const tag = href ? 'a' : 'article';
const extra = href
  ? 'block hover:shadow-md hover:border-sky-300 dark:hover:border-sky-700 transition-all group'
  : 'p-6 hover:shadow-md transition-shadow';
---
<tag
  class={`${base} ${extra} ${className}`}
  {...href ? { href, target: '_blank', rel: 'noopener noreferrer' } : {}}
>
  <slot />
</tag>
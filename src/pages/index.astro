---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import ExperienceSection from '../components/ExperienceSection.astro';
import EducationSection from '../components/EducationSection.astro';
import SkillsSection from '../components/SkillsSection.astro';
import GitHubSection from '../components/GitHubSection.astro';
import SideProjectsSection from '../components/SideProjectsSection.astro';
import PublicationsSection from '../components/PublicationsSection.astro';
import LanguagesSection from '../components/LanguagesSection.astro';
---

<Layout
  title="Hamdi Bouhani — Back End Developer"
  bodyClass="bg-slate-50 dark:bg-slate-950 text-slate-900 dark:text-slate-100 antialiased selection:bg-sky-200 selection:text-sky-900 dark:selection:bg-sky-800 dark:selection:text-sky-100"
>
  <main class="mx-auto max-w-3xl px-6 py-12 sm:py-16 animate-[fadeIn_0.4s_ease-out]">
    <Header />

    <div class="space-y-12">
      <ExperienceSection />
      <EducationSection />
      <SkillsSection />
      <GitHubSection />
      <SideProjectsSection />
      <PublicationsSection />
      <LanguagesSection />
    </div>

    <footer class="mt-16 pt-8 border-t border-slate-200 dark:border-slate-800 text-center text-sm text-slate-500 dark:text-slate-400">
      © {new Date().getFullYear()} Hamdi Bouhani · Built with Astro &amp; Tailwind
    </footer>
  </main>
</Layout>

<style is:global>
  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(4px); }
    to   { opacity: 1; transform: translateY(0); }
  }
</style>